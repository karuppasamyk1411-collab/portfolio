# ═════════════════════════════════════════════════════════════════
#  TEMPLATE: copy this file to ".env" and fill in your own details.
#  The real .env is personal: keep it out of public repositories.
#
#  • Only keys starting with VITE_ are read.
#  • Values end up on the public website, so never put passwords,
#    API keys, tokens or a phone number here.
#  • Long text / HTML / lists go inside backticks `...`.
#  • Lists are JSON: keep [ ] { } , and "quotes" exactly.
#  • Don't use the $ character.
# ═════════════════════════════════════════════════════════════════

# ── Profile ──
VITE_NAME="Your Name"
VITE_SHORT_NAME="YOURNAME"
VITE_ROLE="Cybersecurity Analyst · Software Engineer"
VITE_TAGLINE="One sentence about what you do."
VITE_LOCATION="City, Country"
VITE_STATUS="Right to work: …"
VITE_OPEN_TO="Open to … roles"
VITE_PHOTO="me.jpg"

# ── Contact links ──
VITE_EMAIL="you@example.com"
VITE_LINKEDIN_URL="https://linkedin.com/in/your-handle"
VITE_GITHUB_URL="https://github.com/your-handle"
VITE_TRYHACKME_USER="your-thm-username"

# ── About (HTML allowed) ──
VITE_ABOUT=`
<p>A short paragraph about you. <strong>Bold</strong> the key part.</p>
`

# ── Highlight numbers ──
VITE_HIGHLIGHTS=`[
  { "value": "100+", "label": "something you shipped" },
  { "value": "3 yrs", "label": "experience" }
]`

# ── Skills ──
VITE_SKILLS=`[
  { "category": "SIEM & Detection", "color": "#00f0ff", "items": ["Splunk", "Sentinel"] },
  { "category": "Code", "color": "#8a5cff", "items": ["Python", "Bash"] }
]`

# ── Work experience ──
VITE_EXPERIENCE=`[
  { "period": "2022 – 2025", "role": "Job title", "company": "Company", "location": "City", "points": ["What you did."] }
]`

# ── Education ──
VITE_EDUCATION=`[
  { "period": "2025 – 2026", "role": "Degree", "company": "University", "points": [] }
]`

# ── Certifications ("note" is optional) ──
VITE_CERTIFICATIONS=`[
  { "group": "Security", "name": "Certification name", "note": "optional note" }
]`

# ── Projects ──
VITE_PROJECTS=`[
  {
    "title": "Project name",
    "tagline": "One-line summary",
    "metric": "Headline number",
    "description": "What it does and what you found.",
    "tags": ["Python"],
    "color": "#00f0ff",
    "links": [{ "label": "GitHub", "url": "https://github.com/your-handle/project" }]
  }
]`

# ── CTF ──
VITE_CTF_TITLE="Competition: result"
VITE_CTF_TEXT="Short description"
VITE_CTF_HTML=`<p>Message shown when someone finds the flag.</p>`

# ── Contact message ──
VITE_CONTACT_MESSAGE=`<p>What roles you're looking for.</p>`

# ── TryHackMe ──
VITE_TRYHACKME_TAGLINE="Hacking served fresh, 24/7"
VITE_TRYHACKME_MENU=`[
  { "item": "SOC Level 1 path", "status": "Completed", "done": true }
]`
VITE_TRYHACKME_STATS=`[]`

# ── 3D SOC monitors ──
VITE_SOC_HOSTNAME="soc-sensor-01"
VITE_SOC_DOMAIN="CORP"

# ── Page headings & blurbs ──
VITE_TEXT_MONITOR_TITLE="A shift on the blue team"
VITE_TEXT_MONITOR_SUB="Simulated telemetry. Click a screen to zoom in."
VITE_TEXT_ABOUT_TITLE="About me"
VITE_TEXT_FOCUS="Your focus areas"
VITE_TEXT_EXPERIENCE_TITLE="Experience"
VITE_TEXT_PROJECTS_TITLE="Selected work"
VITE_TEXT_SKILLS_TITLE="Technical toolkit"
VITE_TEXT_CERTS_TITLE="Certifications"
VITE_TEXT_THM_TEXT="How you practise."
VITE_TEXT_WORLD_TITLE="Explore my 3D world"
VITE_TEXT_WORLD_TEXT="Drive around a tiny planet where every landmark is part of this CV."
VITE_TEXT_CONTACT_TITLE="Let's work together"
